# ---- MANDATORY ----
PORT=5000

# NOTE: no Prisma-only query params here (?connection_limit / ?schema).
# asyncpg rejects them. Pool sizing lives in create_async_engine().
DATABASE_URL=postgresql+asyncpg://ticket:ticket@localhost:5433/ticket_booking_platform

REDIS_URL=redis://localhost:6379/0

JWT_SECRET=dev-jwt-secret-change-me-in-production-0123456789
JWT_EXPIRES_DAYS=7

# Signs the session cookie that holds Authlib's OAuth state.
SESSION_SECRET=dev-session-secret-change-me-in-production-0123456789

# ---- FRONTEND / CORS ----
FRONTEND_URL=http://localhost:4000
FRONTEND_URL_ALT=http://localhost:3000

# ---- OPTIONAL (Google OAuth is skipped unless both are set) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# ---- PAYMENTS ----
# "mock"     : built-in simulated gateway. No keys, no network, works offline.
#              This is the default so the repo runs out of the box.
# "razorpay" : real Razorpay TEST mode -- a working UPI tab (VPA + QR) and cards.
#              Test keys come from the Razorpay dashboard with an email signup;
#              no KYC, no expiry, free. Live keys are a separate thing entirely.
PAYMENT_PROVIDER=mock
PAYMENT_CURRENCY=INR

# Only read when PAYMENT_PROVIDER=razorpay; the app refuses to start without them.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Set in Dashboard > Settings > Webhooks. NOT the key secret -- a different value.
# Without it the webhook endpoint rejects everything, which is the safe default:
# an unset secret must never become an unauthenticated way to confirm bookings.
# Note that Razorpay cannot reach http://localhost, so testing webhooks locally
# needs a tunnel (ngrok / cloudflared).
RAZORPAY_WEBHOOK_SECRET=

# Test instruments (both providers accept the same ones):
#   UPI  success@razorpay / failure@razorpay
#   card 4111 1111 1111 1111 (any future expiry, any CVV) / 4000 0000 0000 0002 declines

# ---- MISC ----
NODE_ENV=development
SOCKETIO_CHANNEL=socketio
